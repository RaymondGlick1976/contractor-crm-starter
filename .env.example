# Copy this file to .env for local development (netlify dev).
# In production, set the same variables in Netlify → Site configuration → Environment variables.
# Never commit .env — it is already in .gitignore.

# ---- Required ---------------------------------------------------------------
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # secret — server only, never in the browser

# Resend → API Keys
RESEND_API_KEY=
# A sender address on a domain you verified in Resend
EMAIL_FROM=notifications@yourdomain.com

# Your Netlify site URL, no trailing slash
SITE_URL=https://your-site.netlify.app

# ---- Optional: online card payments (Stripe Connect) -----------------------
# Leave blank to hide "Online Payments" in Settings. See SETUP.md → Stripe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Optional: Google Calendar sync ----------------------------------------
# Leave blank to hide "Google Calendar" in Settings. See SETUP.md → Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional ---------------------------------------------------------------
# Resend webhook signing secret (whsec_...) for delivery/bounce tracking. See SETUP.md.
RESEND_WEBHOOK_SECRET=
# Signs booking/cancel links. Derived from the service key when unset.
BOOKING_TOKEN_SECRET=
